__pycache__/
*.pyc
.pytest_cache/
.venv/
venv/
*.egg-info/
build/
dist/

# User-generated outputs are regeneratable and stay untracked by default.
# Specific bundled artefacts below are force-included via `!` so the
# trained checkpoint, FFT reference, and cached plot NPZs ship with the
# repo.
data/*.npz
data/*.pkl
checkpoints/*.pkl
figures/*.png
figures/*.pdf
logs/*.log

# Bundled artefacts (trained checkpoint + cached reproduction data).
!checkpoints/morse_d4.pkl
!data/fft_ref_morse_d4.npz
!data/fig1_doublewell.npz
!data/fig4_moments.npz
!data/fig5_score_data.npz

# macOS
.DS_Store
